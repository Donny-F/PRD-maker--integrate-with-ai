NEXTAUTH_URL=http://localhost:3000
# Must match the backend AUTH_SECRET so OAuth accounts can be synced.
NEXTAUTH_SECRET=super-secret-auth-key-change-in-production-12345678
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# OAuth providers. Callback URLs to register with each provider:
#   Google: http://localhost:3000/api/auth/callback/google
#   GitHub: http://localhost:3000/api/auth/callback/github
# Providers without credentials are hidden on the login page.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
