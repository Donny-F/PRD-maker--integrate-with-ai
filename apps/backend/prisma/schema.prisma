datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String    @id @default(uuid())
  name      String?
  email     String    @unique
  image     String?
  role      Role      @default(USER)
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model LlmConfig {
  id                String    @id @default(uuid())
  provider          String // e.g. "google", "deepseek"
  displayName       String // e.g. "Antigravity Flash 3.8", "DeepSeek v4.1"
  modelIdentifier   String // e.g. "gemini-1.5-flash", "deepseek-chat"
  baseUrl           String // OpenAI-compatible base URL
  encryptedApiKey   String? // AES-256-GCM encrypted
  isActive          Boolean   @default(true)
  // Set when the provider reports exhausted quota/rate limits. While
  // unavailableUntil is in the future the model must not be selected.
  unavailableUntil  DateTime?
  unavailableReason String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Project {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  initialPrompt    String           @db.Text
  clarifications   Json? // Array [{ question: string, answer: string }]
  currentVersionId String?
  versions         ProjectVersion[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model ProjectVersion {
  id             String   @id @default(uuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versionNumber  Int
  revisionPrompt String?  @db.Text
  prdContent     String   @db.Text
  diagramData    Json // { nodes: [...], edges: [...] }
  createdAt      DateTime @default(now())

  @@unique([projectId, versionNumber])
}
